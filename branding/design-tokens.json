{
  "$description": "عِمارة.كوم / 3maracom design tokens (W3C DTCG format, Style Dictionary 4 / Tokens Studio compatible)",
  "color": {
    "primary": {
      "$type": "color",
      "50":  { "$value": "#EEF3FA" },
      "100": { "$value": "#D9E4F3" },
      "200": { "$value": "#B3C8E6" },
      "300": { "$value": "#85A5D2" },
      "400": { "$value": "#5680BA" },
      "500": { "$value": "#345F9C" },
      "600": { "$value": "#254A80" },
      "700": { "$value": "#1C3B67" },
      "800": { "$value": "#152D4F" },
      "900": { "$value": "#0E1F38" }
    },
    "accent": {
      "$type": "color",
      "50":  { "$value": "#FDF3EE" },
      "100": { "$value": "#FAE1D3" },
      "200": { "$value": "#F4C2A6" },
      "300": { "$value": "#EC9C73" },
      "400": { "$value": "#E27A4A" },
      "500": { "$value": "#D2602F" },
      "600": { "$value": "#B84C22" },
      "700": { "$value": "#953C1C" },
      "800": { "$value": "#732F19" },
      "900": { "$value": "#4F2113" }
    },
    "success": {
      "$type": "color",
      "50":  { "$value": "#F0FDF4" },
      "100": { "$value": "#DCFCE7" },
      "500": { "$value": "#22C55E" },
      "600": { "$value": "#16A34A" },
      "700": { "$value": "#15803D" },
      "800": { "$value": "#166534" }
    },
    "warning": {
      "$type": "color",
      "50":  { "$value": "#FFFBEB" },
      "100": { "$value": "#FEF3C7" },
      "500": { "$value": "#F59E0B" },
      "600": { "$value": "#D97706" },
      "700": { "$value": "#B45309" },
      "800": { "$value": "#92400E" }
    },
    "danger": {
      "$type": "color",
      "50":  { "$value": "#FEF2F2" },
      "100": { "$value": "#FEE2E2" },
      "500": { "$value": "#EF4444" },
      "600": { "$value": "#DC2626" },
      "700": { "$value": "#B91C1C" },
      "800": { "$value": "#991B1B" }
    },
    "info": {
      "$type": "color",
      "50":  { "$value": "#F0F9FF" },
      "100": { "$value": "#E0F2FE" },
      "500": { "$value": "#0EA5E9" },
      "600": { "$value": "#0284C7" },
      "700": { "$value": "#0369A1" },
      "800": { "$value": "#075985" }
    },
    "neutral": {
      "$type": "color",
      "0":   { "$value": "#FFFFFF" },
      "50":  { "$value": "#F6F7F9" },
      "100": { "$value": "#EDEFF3" },
      "200": { "$value": "#DDE1E8" },
      "300": { "$value": "#C3C9D4" },
      "400": { "$value": "#98A1B1" },
      "500": { "$value": "#6B7589" },
      "600": { "$value": "#525B6E" },
      "700": { "$value": "#3B4354" },
      "800": { "$value": "#262C3A" },
      "900": { "$value": "#161B26" },
      "950": { "$value": "#0C1018" }
    }
  },
  "theme": {
    "light": {
      "$type": "color",
      "bg":              { "$value": "{color.neutral.50}",  "$description": "App background (off-white)" },
      "surface":         { "$value": "{color.neutral.0}",  "$description": "Cards, tables, sheets" },
      "surface-muted":   { "$value": "{color.neutral.100}" },
      "border":          { "$value": "{color.neutral.200}" },
      "text-heading":    { "$value": "{color.neutral.900}", "$description": "17:1 on surface" },
      "text-body":       { "$value": "{color.neutral.600}", "$description": "7:1 on surface" },
      "text-muted":      { "$value": "{color.neutral.500}", "$description": "4.8:1 on surface; captions only" },
      "brand":           { "$value": "{color.primary.600}", "$description": "Headers, nav, links; white text 8.8:1" },
      "brand-soft":      { "$value": "{color.primary.50}" },
      "action":          { "$value": "{color.accent.600}",  "$description": "Primary CTA bg; white text 5.1:1" },
      "action-hover":    { "$value": "{color.accent.700}" },
      "on-action":       { "$value": "{color.neutral.0}" },
      "focus-ring":      { "$value": "{color.primary.400}" },
      "success-text":    { "$value": "{color.success.700}" },
      "success-bg":      { "$value": "{color.success.50}" },
      "warning-text":    { "$value": "{color.warning.700}" },
      "warning-bg":      { "$value": "{color.warning.50}" },
      "danger-text":     { "$value": "{color.danger.700}" },
      "danger-bg":       { "$value": "{color.danger.50}" },
      "info-text":       { "$value": "{color.info.700}" },
      "info-bg":         { "$value": "{color.info.50}" }
    },
    "dark": {
      "$type": "color",
      "bg":              { "$value": "#0F1623", "$description": "Midnight navy; never pure black" },
      "surface":         { "$value": "#172033" },
      "surface-raised":  { "$value": "#1F2A40", "$description": "Modals, menus, sticky headers" },
      "border":          { "$value": "#2B3750" },
      "text-heading":    { "$value": "#F4F6FA", "$description": "15:1 on surface" },
      "text-body":       { "$value": "#B4BCCB", "$description": "8:1 on surface" },
      "text-muted":      { "$value": "#8791A5", "$description": "5:1 on surface" },
      "brand":           { "$value": "{color.primary.300}", "$description": "Links/icons; 6.5:1 on surface" },
      "brand-soft":      { "$value": "#1B2B47" },
      "action":          { "$value": "{color.accent.400}",  "$description": "Dark text on it (6.5:1)" },
      "action-hover":    { "$value": "{color.accent.300}" },
      "on-action":       { "$value": "{color.neutral.950}" },
      "focus-ring":      { "$value": "{color.primary.300}" },
      "success-text":    { "$value": "#4ADE80" },
      "success-bg":      { "$value": "#12301F" },
      "warning-text":    { "$value": "#FBBF24" },
      "warning-bg":      { "$value": "#3A2A0A" },
      "danger-text":     { "$value": "#F87171" },
      "danger-bg":       { "$value": "#3B1717" },
      "info-text":       { "$value": "#38BDF8" },
      "info-bg":         { "$value": "#0E2A3D" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "arabic": { "$value": ["Cairo", "IBM Plex Sans Arabic", "Segoe UI", "Tahoma", "sans-serif"] },
      "latin":  { "$value": ["Inter", "system-ui", "sans-serif"] },
      "numeric":{ "$value": ["Inter", "Cairo", "sans-serif"], "$description": "Use tabular-nums for balances" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "micro":    { "$value": { "fontSize": "0.6875rem", "lineHeight": "1.5",  "fontWeight": 500, "letterSpacing": "0.02em" }, "$description": "11px. Arabic line-height 1.8" },
    "caption":  { "$value": { "fontSize": "0.75rem",   "lineHeight": "1.5",  "fontWeight": 400 }, "$description": "12px. Arabic 1.8" },
    "body-sm":  { "$value": { "fontSize": "0.875rem",  "lineHeight": "1.57", "fontWeight": 400 }, "$description": "14px. Arabic 1.85" },
    "body":     { "$value": { "fontSize": "1rem",      "lineHeight": "1.6",  "fontWeight": 400 }, "$description": "16px default. Arabic 1.9" },
    "body-lg":  { "$value": { "fontSize": "1.125rem",  "lineHeight": "1.6",  "fontWeight": 400 }, "$description": "18px. Arabic 1.9" },
    "title":    { "$value": { "fontSize": "1.25rem",   "lineHeight": "1.4",  "fontWeight": 600 }, "$description": "20px card titles. Arabic 1.7" },
    "h3":       { "$value": { "fontSize": "1.5rem",    "lineHeight": "1.33", "fontWeight": 700 }, "$description": "24px. Arabic 1.6" },
    "h2":       { "$value": { "fontSize": "1.75rem",   "lineHeight": "1.29", "fontWeight": 700 }, "$description": "28px. Arabic 1.55" },
    "h1":       { "$value": { "fontSize": "2.25rem",   "lineHeight": "1.22", "fontWeight": 700 }, "$description": "36px. Arabic 1.5" },
    "display":  { "$value": { "fontSize": "3rem",      "lineHeight": "1.17", "fontWeight": 700, "letterSpacing": "-0.01em" }, "$description": "48px treasury balance. Arabic 1.4" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" }, "md": { "$value": "10px" }, "lg": { "$value": "12px" }, "xl": { "$value": "20px" }, "pill": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "micro": { "$value": [{ "color": "#161B2610", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "card":  { "$value": [{ "color": "#161B2614", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "-2px" }, { "color": "#161B260A", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "float": { "$value": [{ "color": "#0E1F381F", "offsetX": "0px", "offsetY": "12px", "blur": "28px", "spread": "-8px" }] }
  }
}
