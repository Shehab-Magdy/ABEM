{
  // ── Python test discovery (tests/selenium-legacy) ──────────────────────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/tests/selenium-legacy/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/tests/selenium-legacy",
  "python.testing.pytestPath": "${workspaceFolder}/tests/selenium-legacy/.venv/bin/pytest",
  "python.testing.pytestArgs": [
    "tests",
    "--no-header",
    "-p", "no:warnings"
  ],
  "cSpell.words": [
    "ABEM",
    "userbuilding",
    "viewsets"
  ]
}
