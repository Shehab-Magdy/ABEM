msgstr "رقم عملية التحويل عبر إنستا باي"

msgid "Open"
msgstr "مفتوح"

msgid "Password has been reset. You can now sign in."
msgstr "تمت إعادة تعيين كلمة المرور. يمكنك تسجيل الدخول الآن."

msgid "Password is incorrect."
msgstr "كلمة المرور غير صحيحة."

msgid "Pending"
msgstr "قيد الانتظار"

msgid "Rejected"
msgstr "مرفوض"

msgid "Request sent. The building admin will review it."
msgstr "تم إرسال الطلب. سيراجعه مدير العمارة."

msgid "Stairs"
msgstr "السلم"

msgid "This claim was already reviewed."
msgstr "تمت مراجعة هذا الطلب من قبل."

msgid "This invite was sent to a different email address."
msgstr "هذه الدعوة أُرسلت إلى بريد إلكتروني آخر."

msgid "This request was already reviewed."
msgstr "تمت مراجعة هذا الطلب من قبل."

msgid "This reset link is invalid or has expired."
msgstr "رابط إعادة التعيين غير صالح أو انتهت صلاحيته."

msgid "Total allocated (%(sum)s) cannot exceed amount paid (%(amount)s)."
msgstr "مجموع المبالغ المخصّصة (%(sum)s) لا يمكن أن يزيد على المبلغ المدفوع (%(amount)s)."

msgid "Water"
msgstr "المياه"

msgid "You already asked to claim this unit."
msgstr "لقد طلبت الانضمام إلى هذه الوحدة من قبل."

msgid "You are the administrator of a building. Hand it over to another admin before deleting your account."
msgstr "أنت مدير لإحدى العمارات. سلّمها لمدير آخر قبل حذف حسابك."

msgid "You must accept the Terms of Service and Privacy Policy."
msgstr "يجب الموافقة على شروط الاستخدام وسياسة الخصوصية."

msgid "Your account has been deleted."
msgstr "تم حذف حسابك."

msgid "amount must be greater than zero."
msgstr "يجب أن يكون المبلغ أكبر من صفر."

msgid "month must look like 2026-10."
msgstr "الشهر يجب أن يكون بصيغة 2026-10."

msgid "Only the building's primary administrator can hand it over."
msgstr "المدير الأساسي للعمارة هو وحده من يمكنه نقل الإدارة."

msgid "Choose one of the building's co-admins. Add them as a co-admin first."
msgstr "اختر أحد المديرين المشاركين في العمارة. أضفه كمدير مشارك أولاً."

msgid "Renters cannot invite other residents."
msgstr "لا يمكن للمستأجر دعوة سكان آخرين."

msgid "Renters cannot remove other residents."
msgstr "لا يمكن للمستأجر إنهاء ارتباط سكان آخرين."

msgid "That renter does not live in this unit."
msgstr "هذا المستأجر لا يسكن في هذه الوحدة."

msgid "Renters join a unit through an invite from its owner."
msgstr "ينضم المستأجر إلى الوحدة عبر دعوة من مالكها."

msgid "This vote is closed."
msgstr "هذا التصويت مغلق."

msgid "Choose one of this vote's options for your unit."
msgstr "اختر أحد خيارات التصويت لوحدتك."

msgid "This vote is already closed."
msgstr "تم إغلاق هذا التصويت من قبل."

msgid "Only an owner of this unit can vote for it."
msgstr "مالك الوحدة وحده يمكنه التصويت عنها."

msgid "The closing time must be in the future."
msgstr "يجب أن يكون وقت الإغلاق في المستقبل."

msgid "More than half of the votes cast"
msgstr "أكثر من نصف الأصوات"

msgid "At least two thirds of the votes cast"
msgstr "ثلثا الأصوات على الأقل"

msgid "Enter a valid amount, billing day and due days."
msgstr "أدخل مبلغاً ويوم تحصيل وعدد أيام استحقاق صحيحة."

msgid "Amount must be above zero, billing day 1-28 and due days 0-60."
msgstr "يجب أن يكون المبلغ أكبر من صفر، ويوم التحصيل بين 1 و28، وأيام الاستحقاق بين 0 و60."

msgid "Cost"
msgstr "تكلفة"

msgid "Monthly subscription"
msgstr "الاشتراك الشهري"

msgid "Late fee"
msgstr "غرامة تأخير"

msgid "The rate factor must be between 0.1 and 10."
msgstr "يجب أن يكون المعامل بين 0.1 و10."

msgid "Late fee: choose none, a fixed amount or a percent (up to 100), and 0-60 grace days."
msgstr "غرامة التأخير: اختر بدون أو مبلغاً ثابتاً أو نسبة (حتى 100) وأيام سماح من 0 إلى 60."

msgid "Only the building's admins can assign board titles."
msgstr "مديرو العمارة وحدهم يمكنهم تعيين المناصب."

msgid "Choose chair, treasurer or secretary."
msgstr "اختر رئيساً أو أمين صندوق أو أمين سر."

msgid "That person is not a member of this building."
msgstr "هذا الشخص ليس عضواً في هذه العمارة."

msgid "Only the building's admins or treasurer can review this."
msgstr "مديرو العمارة أو أمين الصندوق وحدهم يمكنهم مراجعة هذا."

msgid "Chair"
msgstr "الرئيس"

msgid "Treasurer"
msgstr "أمين الصندوق"

msgid "Secretary"
msgstr "أمين السر"

msgid "Only the building's chair can decide on this expense."
msgstr "رئيس الاتحاد وحده يمكنه البتّ في هذا المصروف."

msgid "This expense is not waiting for approval."
msgstr "هذا المصروف لا ينتظر الاعتماد."

msgid "A vote on this expense is already open."
msgstr "يوجد تصويت مفتوح على هذا المصروف بالفعل."

msgid "Only the building's secretary or admins can keep the minutes."
msgstr "أمين السر أو مديرو العمارة وحدهم يمكنهم تدوين المحاضر وحفظ المستندات."

msgid "Attach a file."
msgstr "أرفق ملفاً."

msgid "Only PDF, JPEG or PNG files are allowed."
msgstr "يُسمح بملفات PDF أو صور JPEG وPNG فقط."

msgid "The file is too large."
msgstr "حجم الملف كبير جداً."

msgid "Contract"
msgstr "عقد"

msgid "Bylaws"
msgstr "لائحة"

msgid "Receipt / proof of work"
msgstr "إيصال / إثبات عمل"

msgid "Minutes"
msgstr "محضر"

msgid "Only the building's admins and board can change this."
msgstr "مديرو العمارة وأعضاء الهيئة وحدهم يمكنهم تعديل هذا."

msgid "Only the building's admins and board can manage work orders."
msgstr "مديرو العمارة وأعضاء الهيئة وحدهم يمكنهم إدارة أوامر العمل."

msgid "This report already has a work order."
msgstr "لهذا البلاغ أمر عمل بالفعل."

msgid "Assigned"
msgstr "تم الإسناد"

msgid "Notification preferences must be on/off switches for: %(keys)s."
msgstr "تفضيلات الإشعارات يجب أن تكون مفاتيح تشغيل/إيقاف للبنود: %(keys)s."

msgid "Attach a CSV file."
msgstr "أرفق ملف CSV."

msgid "The file is too large (1 MB at most)."
msgstr "الملف كبير جداً (1 ميجابايت كحد أقصى)."

msgid "Save the file as UTF-8 CSV."
msgstr "احفظ الملف بصيغة CSV وترميز UTF-8."

msgid "Missing columns: %(cols)s."
msgstr "أعمدة ناقصة: %(cols)s."

msgid "Unknown columns: %(cols)s."
msgstr "أعمدة غير معروفة: %(cols)s."

msgid "The file has no rows."
msgstr "الملف لا يحتوي على صفوف."

msgid "At most %(n)s rows per file."
msgstr "الحد الأقصى %(n)s صف في الملف."

msgid "unit_number is required."
msgstr "رقم الوحدة مطلوب."

msgid "This unit already exists in the building."
msgstr "هذه الوحدة موجودة بالفعل في العمارة."

msgid "This unit appears twice in the file."
msgstr "هذه الوحدة مكررة في الملف."

msgid "type must be apartment or store."
msgstr "النوع يجب أن يكون apartment أو store."

msgid "floor must be between 0 and %(n)s."
msgstr "الطابق يجب أن يكون بين 0 و%(n)s."

msgid "floor must be a whole number."
msgstr "الطابق يجب أن يكون رقماً صحيحاً."

msgid "size_sqm must be a positive number."
msgstr "المساحة يجب أن تكون رقماً موجباً."

msgid "category must be one of: %(names)s."
msgstr "الفئة يجب أن تكون إحدى: %(names)s."

msgid "year must look like 2026."
msgstr "السنة يجب أن تكون بالشكل 2026."

msgid "A unit cannot be moved to another building."
msgstr "لا يمكن نقل الوحدة إلى عمارة أخرى."

msgid "An asset cannot be moved to another building."
msgstr "لا يمكن نقل الأصل إلى عمارة أخرى."

msgid "An expense cannot be moved to another building."
msgstr "لا يمكن نقل المصروف إلى عمارة أخرى."

msgid "This category belongs to another building."
msgstr "هذه الفئة تابعة لعمارة أخرى."

msgid "Every unit in a custom split must belong to this building."
msgstr "يجب أن تنتمي كل وحدة في التقسيم المخصص إلى هذه العمارة."

msgid "A reason is required to reverse a payment."
msgstr "السبب مطلوب لإلغاء الدفعة."

msgid "A reversal cannot itself be reversed."
msgstr "لا يمكن إلغاء عملية إلغاء."

msgid "This payment was already reversed."
msgstr "تم إلغاء هذه الدفعة مسبقاً."

msgid "sale_price must be greater than zero."
msgstr "سعر البيع يجب أن يكون أكبر من صفر."

msgid "This expense has payments. Its amount, split and units cannot be changed; reverse the payments or add a credit note instead."
msgstr "عليه مدفوعات. لا يمكن تغيير مبلغ هذا المصروف أو تقسيمه أو وحداته؛ قم بإلغاء المدفوعات أو أضف إشعار دائن بدلاً من ذلك."

msgid "This expense has payments and cannot be deleted. Reverse the payments or add a credit note instead."
msgstr "عليه مدفوعات ولا يمكن حذفه. قم بإلغاء المدفوعات أو أضف إشعار دائن بدلاً من ذلك."
