#: apps/apartments/models.py:14
msgid "Apartment"
msgstr "شقة سكنية"

#: apps/apartments/models.py:15
msgid "Store"
msgstr "محل تجاري"

#: apps/apartments/models.py:19
msgid "Occupied"
msgstr "مشغول"

#: apps/apartments/models.py:20
msgid "Vacant"
msgstr "شاغر"

#: apps/apartments/models.py:21
msgid "Under Maintenance"
msgstr "تحت الصيانة"

#: apps/apartments/serializers.py:76
msgid "The rate factor must be between 0.1 and 10."
msgstr "يجب أن يكون المعامل بين 0.1 و10."

#: apps/apartments/serializers.py:99
msgid "A unit cannot be moved to another building."
msgstr "لا يمكن نقل الوحدة إلى عمارة أخرى."

#: apps/apartments/serializers.py:111
msgid ""
"Only people already in the building can be made owners. Invite them instead."
msgstr ""
"لا يمكن تعيين مالك إلا من الأشخاص الموجودين في المبنى. قم بدعوته بدلاً من ذلك."

#: apps/apartments/serializers.py:118
#, python-format
msgid ""
"Floor %(floor)s exceeds the building's maximum of %(num_floors)s floor(s)."
msgstr ""
"الطابق %(floor)s يتجاوز الحد الأقصى للمبنى البالغ %(num_floors)s طابق(طوابق)."

#: apps/apartments/views.py:87 apps/buildings/views.py:267
msgid "Your plan's unit limit is reached. Upgrade the plan to add more units."
msgstr ""
"تم بلوغ الحد الأقصى للوحدات في باقتك. قم بترقية الباقة لإضافة المزيد من "
"الوحدات."

#: apps/apartments/views.py:203
msgid "building_id query parameter is required."
msgstr "معرّف المبنى (building_id) مطلوب."

#: apps/apartments/views.py:224
msgid "Apartment not found."
msgstr "الوحدة غير موجودة."

#: apps/apartments/views.py:228
msgid "Renters join a unit through an invite from its owner."
msgstr "ينضم المستأجر إلى الوحدة عبر دعوة من مالكها."

#: apps/apartments/views.py:233
msgid "This apartment is already assigned to an owner."
msgstr "هذه الوحدة مسندة بالفعل إلى مالك."

#: apps/apartments/views.py:243
msgid "You already asked to claim this unit."
msgstr "لقد طلبت الانضمام إلى هذه الوحدة من قبل."

#: apps/apartments/views.py:245
msgid "Request sent. The building admin will review it."
msgstr "تم إرسال الطلب. سيراجعه مدير العمارة."

#: apps/apartments/views.py:289
msgid "Enter a valid email address."
msgstr "أدخل عنوان بريد إلكتروني صالحاً."

#: apps/apartments/views.py:321
msgid "Renters cannot invite other residents."
msgstr "لا يمكن للمستأجر دعوة سكان آخرين."

#: apps/apartments/views.py:332
msgid "Renters cannot remove other residents."
msgstr "لا يمكن للمستأجر إنهاء ارتباط سكان آخرين."

#: apps/apartments/views.py:337
msgid "That renter does not live in this unit."
msgstr "هذا المستأجر لا يسكن في هذه الوحدة."

#: apps/apartments/views.py:364 apps/apartments/views.py:405
msgid "token or code is required."
msgstr "الرمز أو كود الدعوة مطلوب."

#: apps/apartments/views.py:375
msgid "Invalid invite link or code."
msgstr "رابط أو كود الدعوة غير صالح."

#: apps/apartments/views.py:378 apps/apartments/views.py:415
msgid "This invite link has expired or already been used."
msgstr "رابط الدعوة منتهي الصلاحية أو تم استخدامه بالفعل."

#: apps/apartments/views.py:412
msgid "Invalid invite."
msgstr "دعوة غير صالحة."

#: apps/apartments/views.py:421
msgid "This invite was sent to a different email address."
msgstr "هذه الدعوة أُرسلت إلى بريد إلكتروني آخر."

#: apps/apartments/views.py:429
msgid "You are already an owner of this unit."
msgstr "أنت بالفعل مالك هذه الوحدة."

#: apps/apartments/views.py:471
msgid "You do not have permission to view this apartment's balance."
msgstr "ليس لديك صلاحية لعرض رصيد هذه الوحدة."

#: apps/apartments/views.py:531 apps/apartments/views.py:555
msgid "This request was already reviewed."
msgstr "تمت مراجعة هذا الطلب من قبل."

#: apps/authentication/otp.py:121
msgid "No active code was found for this email. Request a new one."
msgstr "لم يتم العثور على رمز نشط لهذا البريد الإلكتروني. اطلب رمزاً جديداً."

#: apps/authentication/otp.py:122
msgid "This code has expired. Request a new one."
msgstr "انتهت صلاحية هذا الرمز. اطلب رمزاً جديداً."

#: apps/authentication/otp.py:123
msgid "Incorrect code."
msgstr "رمز غير صحيح."

#: apps/authentication/otp.py:124
msgid "Too many attempts. Request a new code."
msgstr "عدد كبير جداً من المحاولات. اطلب رمزاً جديداً."

#: apps/authentication/otp.py:125
msgid "Could not verify this code."
msgstr "تعذر التحقق من هذا الرمز."

#: apps/authentication/serializers.py:147
#: apps/authentication/serializers.py:534
msgid "A user with this email already exists."
msgstr "يوجد مستخدم بهذا البريد الإلكتروني بالفعل."

#: apps/authentication/serializers.py:158
#: apps/authentication/serializers.py:323
msgid "At least one building must be assigned to an admin user."
msgstr "يجب تعيين مبنى واحد على الأقل لمستخدم مدير."

#: apps/authentication/serializers.py:177
#: apps/authentication/serializers.py:333
msgid "You do not manage all selected buildings."
msgstr "أنت لا تدير جميع المباني المحددة."

#: apps/authentication/serializers.py:195
#: apps/authentication/serializers.py:344
msgid "One or more apartments do not exist."
msgstr "شقة واحدة أو أكثر غير موجودة."

#: apps/authentication/serializers.py:202
#: apps/authentication/serializers.py:351
msgid "You do not manage the building(s) for all selected apartments."
msgstr "أنت لا تدير مبنى (مباني) جميع الشقق المحددة."

#: apps/authentication/serializers.py:497
#, python-format
msgid "Notification preferences must be on/off switches for: %(keys)s."
msgstr "تفضيلات الإشعارات يجب أن تكون مفاتيح تشغيل/إيقاف للبنود: %(keys)s."

#: apps/authentication/serializers.py:541
msgid "You must accept the Terms of Service and Privacy Policy."
msgstr "يجب الموافقة على شروط الاستخدام وسياسة الخصوصية."

#: apps/authentication/user_views.py:129
msgid "You cannot deactivate your own account."
msgstr "لا يمكنك تعطيل حسابك الشخصي."

#: apps/authentication/user_views.py:141
#, python-format
msgid "User %(email)s deactivated."
msgstr "تم تعطيل حساب المستخدم %(email)s."

#: apps/authentication/user_views.py:155
#, python-format
msgid "User %(email)s activated."
msgstr "تم تفعيل حساب المستخدم %(email)s."

#: apps/authentication/user_views.py:176
msgid "Provide messaging_blocked or individual_messaging_blocked."
msgstr "يرجى تحديد messaging_blocked أو individual_messaging_blocked."

#: apps/authentication/user_views.py:210
#, python-format
msgid "A sign-in code has been sent to %(email)s."
msgstr "تم إرسال رمز تسجيل الدخول إلى %(email)s."

#: apps/authentication/views.py:131
msgid "Too many requests. Please wait a moment and try again."
msgstr "عدد كبير جداً من الطلبات. يرجى الانتظار قليلاً والمحاولة مرة أخرى."

#: apps/authentication/views.py:145 apps/authentication/views.py:197
#: apps/authentication/views.py:271
msgid "This account has been deactivated."
msgstr "هذا الحساب معطّل."

#: apps/authentication/views.py:173
msgid "A sign-in code has been sent to your email."
msgstr "تم إرسال رمز تسجيل الدخول إلى بريدك الإلكتروني."

#: apps/authentication/views.py:191
msgid "No sign-in code was requested for this email."
msgstr "لم يُطلب رمز تسجيل دخول لهذا البريد الإلكتروني."

#: apps/authentication/views.py:239
msgid "Google Sign-In is not configured."
msgstr "تسجيل الدخول بواسطة جوجل غير مُفعَّل."

#: apps/authentication/views.py:249 apps/authentication/views.py:256
msgid "Invalid Google sign-in token."
msgstr "رمز تسجيل الدخول بواسطة جوجل غير صالح."

#: apps/authentication/views.py:307
msgid "Refresh token is required."
msgstr "رمز التحديث مطلوب."

#: apps/authentication/views.py:385
msgid "This refresh token was already used. Please try again."
msgstr "تم استخدام رمز التحديث هذا من قبل. يرجى المحاولة مرة أخرى."

#: apps/authentication/views.py:403
msgid "Session invalidated for your safety. Please sign in again."
msgstr "تم إلغاء الجلسة لحمايتك. يرجى تسجيل الدخول مرة أخرى."

#: apps/authentication/views.py:408
msgid "Refresh token is invalid or expired."
msgstr "رمز التحديث غير صالح أو منتهي الصلاحية."

#: apps/authentication/views.py:427
msgid "No session to log out of."
msgstr "لا توجد جلسة لتسجيل الخروج منها."

#: apps/authentication/views.py:436
msgid "Token is invalid or already blacklisted."
msgstr "الرمز غير صالح أو تم إبطاله بالفعل."

#: apps/authentication/views.py:455
msgid "Successfully logged out."
msgstr "تم تسجيل الخروج بنجاح."

#: apps/authentication/views.py:512
msgid "All trusted devices have been revoked."
msgstr "تم إبطال جميع الأجهزة الموثوقة."

#: apps/authentication/views.py:556
msgid "Use /auth/logout/ to sign out of your current session."
msgstr "استخدم /auth/logout/ لتسجيل الخروج من جلستك الحالية."

#: apps/authentication/views.py:579
msgid "Session revoked."
msgstr "تم إبطال الجلسة."

#: apps/authentication/views.py:733
msgid ""
"You are the administrator of a building. Hand it over to another admin "
"before deleting your account."
msgstr "أنت مدير لإحدى العمارات. سلّمها لمدير آخر قبل حذف حسابك."

#: apps/authentication/views.py:746
msgid ""
"You are the last platform owner. Make someone else a platform owner first."
msgstr "أنت آخر مالك للمنصة. عيّن مالكاً آخر للمنصة أولاً."

#: apps/authentication/views.py:761
msgid ""
"You still owe a balance on your unit. Send confirm_balance to delete your "
"account anyway."
msgstr ""
"ما زال عليك رصيد مستحق على وحدتك. أكّد (confirm_balance) لحذف حسابك رغم ذلك."

#: apps/authentication/views.py:829
msgid "Your account has been deleted."
msgstr "تم حذف حسابك."

#: apps/buildings/serializers.py:39
msgid "Number of apartment units in the building."
msgstr "عدد الشقق السكنية في المبنى."

#: apps/buildings/serializers.py:45
msgid "Number of store/commercial units in the building."
msgstr "عدد المحلات التجارية في المبنى."

#: apps/buildings/serializers.py:75
msgid "num_floors must be a positive integer greater than 0."
msgstr "عدد الطوابق يجب أن يكون عدداً صحيحاً موجباً أكبر من صفر."

#: apps/buildings/serializers.py:192
msgid "User not found."
msgstr "المستخدم غير موجود."

#: apps/buildings/views.py:170
#, python-format
msgid "User '%(email)s' assigned to building '%(name)s'."
msgstr "تم تعيين المستخدم '%(email)s' في المبنى '%(name)s'."

#: apps/buildings/views.py:183
msgid "Only the building's primary administrator can hand it over."
msgstr "المدير الأساسي للعمارة هو وحده من يمكنه نقل الإدارة."

#: apps/buildings/views.py:189
msgid "Choose one of the building's co-admins. Add them as a co-admin first."
msgstr "اختر أحد المديرين المشاركين في العمارة. أضفه كمدير مشارك أولاً."

#: apps/buildings/views.py:231
msgid "unit_number is required."
msgstr "رقم الوحدة مطلوب."

#: apps/buildings/views.py:233
msgid "This unit already exists in the building."
msgstr "هذه الوحدة موجودة بالفعل في العمارة."

#: apps/buildings/views.py:235
msgid "This unit appears twice in the file."
msgstr "هذه الوحدة مكررة في الملف."

#: apps/buildings/views.py:238
msgid "type must be apartment or store."
msgstr "النوع يجب أن يكون apartment أو store."

#: apps/buildings/views.py:244
#, python-format
msgid "floor must be between 0 and %(n)s."
msgstr "الطابق يجب أن يكون بين 0 و%(n)s."

#: apps/buildings/views.py:246
msgid "floor must be a whole number."
msgstr "الطابق يجب أن يكون رقماً صحيحاً."

#: apps/buildings/views.py:254
msgid "size_sqm must be a positive number."
msgstr "المساحة يجب أن تكون رقماً موجباً."

#: apps/buildings/views.py:290
msgid "Only the building's admins can assign board titles."
msgstr "مديرو العمارة وحدهم يمكنهم تعيين المناصب."

#: apps/buildings/views.py:293
msgid "Choose chair, treasurer or secretary."
msgstr "اختر رئيساً أو أمين صندوق أو أمين سر."

#: apps/buildings/views.py:297
msgid "That person is not a member of this building."
msgstr "هذا الشخص ليس عضواً في هذه العمارة."

#: apps/buildings/views.py:355
msgid "Monthly subscription billing is part of the Standard and Plus plans."
msgstr "الفوترة بالاشتراك الشهري جزء من باقتي القياسية وبلس."

#: apps/buildings/views.py:367
msgid "Enter a valid amount, billing day and due days."
msgstr "أدخل مبلغاً ويوم تحصيل وعدد أيام استحقاق صحيحة."

#: apps/buildings/views.py:369
msgid "Amount must be above zero, billing day 1-28 and due days 0-60."
msgstr ""
"يجب أن يكون المبلغ أكبر من صفر، ويوم التحصيل بين 1 و28، وأيام الاستحقاق بين "
"0 و60."

#: apps/buildings/views.py:377
msgid ""
"Late fee: choose none, a fixed amount or a percent (up to 100), and 0-60 "
"grace days."
msgstr ""
"غرامة التأخير: اختر بدون أو مبلغاً ثابتاً أو نسبة (حتى 100) وأيام سماح من 0 "
"إلى 60."

#: apps/buildings/views.py:409
msgid "month must look like 2026-10."
msgstr "الشهر يجب أن يكون بصيغة 2026-10."

#: apps/buildings/views.py:456
msgid "The annual report is part of the Plus plan."
msgstr "التقرير السنوي جزء من باقة بلس."

#: apps/buildings/views.py:462
msgid "year must look like 2026."
msgstr "السنة يجب أن تكون بالشكل 2026."

#: apps/buildings/views.py:570
#, python-format
msgid "Building '%(name)s' deactivated."
msgstr "تم تعطيل المبنى '%(name)s'."

#: apps/buildings/views.py:589
#, python-format
msgid "Building '%(name)s' activated."
msgstr "تم تفعيل المبنى '%(name)s'."

#: apps/core/csv_import.py:20
msgid "Attach a CSV file."
msgstr "أرفق ملف CSV."

#: apps/core/csv_import.py:22
msgid "The file is too large (1 MB at most)."
msgstr "الملف كبير جداً (1 ميجابايت كحد أقصى)."

#: apps/core/csv_import.py:26
msgid "Save the file as UTF-8 CSV."
msgstr "احفظ الملف بصيغة CSV وترميز UTF-8."

#: apps/core/csv_import.py:34
#, python-format
msgid "Missing columns: %(cols)s."
msgstr "أعمدة ناقصة: %(cols)s."

#: apps/core/csv_import.py:36
#, python-format
msgid "Unknown columns: %(cols)s."
msgstr "أعمدة غير معروفة: %(cols)s."

#: apps/core/csv_import.py:43
msgid "The file has no rows."
msgstr "الملف لا يحتوي على صفوف."

#: apps/core/csv_import.py:45
#, python-format
msgid "At most %(n)s rows per file."
msgstr "الحد الأقصى %(n)s صف في الملف."

#: apps/dashboard/views.py:46
msgid "Building not found or not accessible by you."
msgstr "المبنى غير موجود أو ليس لديك صلاحية الوصول إليه."

#: apps/dashboard/views.py:261 apps/notifications/models.py:68
msgid "Overdue"
msgstr "متأخر"

#: apps/dashboard/views.py:261
msgid "Active"
msgstr "نشط"

#: apps/expenses/models.py:19
msgid "Material icon name (used by web and mobile)"
msgstr "اسم أيقونة Material (للويب والموبايل)"

#: apps/expenses/models.py:21
msgid "Hex color for the category badge"
msgstr "لون Hex لشارة الفئة"

#: apps/expenses/models.py:41
msgid "Equal – All Units"
msgstr "توزيع متساوٍ على الجميع"

#: apps/expenses/models.py:42
msgid "Equal – Apartments Only"
msgstr "الشقق السكنية فقط"

#: apps/expenses/models.py:43
msgid "Equal – Stores Only"
msgstr "المحلات التجارية فقط"

#: apps/expenses/models.py:44
msgid "Custom Subset"
msgstr "توزيع مخصص"

#: apps/expenses/models.py:48 apps/plans/models.py:60
msgid "Monthly"
msgstr "شهري"

#: apps/expenses/models.py:49
msgid "Quarterly"
msgstr "ربع سنوي"

#: apps/expenses/models.py:50
msgid "Annual"
msgstr "سنوي"

#: apps/expenses/models.py:54
msgid "Cost"
msgstr "تكلفة"

#: apps/expenses/models.py:55
msgid "Monthly subscription"
msgstr "الاشتراك الشهري"

#: apps/expenses/models.py:56
msgid "Late fee"
msgstr "غرامة تأخير"

#: apps/expenses/serializers.py:182
msgid "amount must be greater than 0."
msgstr "يجب أن يكون المبلغ أكبر من صفر."

#: apps/expenses/serializers.py:189
msgid "An expense cannot be moved to another building."
msgstr "لا يمكن نقل المصروف إلى عمارة أخرى."

#: apps/expenses/serializers.py:193
msgid "This category belongs to another building."
msgstr "هذه الفئة تابعة لعمارة أخرى."

#: apps/expenses/serializers.py:205
msgid "Every unit in a custom split must belong to this building."
msgstr "يجب أن تنتمي كل وحدة في التقسيم المخصص إلى هذه العمارة."

#: apps/expenses/serializers.py:213
msgid "frequency is required when is_recurring is true."
msgstr "التكرار مطلوب عند تفعيل خيار المصروف المتكرر."

#: apps/expenses/serializers.py:230
msgid ""
"This expense has payments. Its amount, split and units cannot be changed; "
"reverse the payments or add a credit note instead."
msgstr ""
"عليه مدفوعات. لا يمكن تغيير مبلغ هذا المصروف أو تقسيمه أو وحداته؛ قم بإلغاء "
"المدفوعات أو أضف إشعار دائن بدلاً من ذلك."

#: apps/expenses/views.py:209
#, python-format
msgid "category must be one of: %(names)s."
msgstr "الفئة يجب أن تكون إحدى: %(names)s."

#: apps/expenses/views.py:238
msgid "Only the building's chair can decide on this expense."
msgstr "رئيس الاتحاد وحده يمكنه البتّ في هذا المصروف."

#: apps/expenses/views.py:240
msgid "This expense is not waiting for approval."
msgstr "هذا المصروف لا ينتظر الاعتماد."

#: apps/expenses/views.py:274
msgid "A vote on this expense is already open."
msgstr "يوجد تصويت مفتوح على هذا المصروف بالفعل."

#: apps/expenses/views.py:276
#, python-format
msgid "Approve this expense: %(title)s (%(amount)s)"
msgstr "الموافقة على مصروف: %(title)s (%(amount)s)"

#: apps/expenses/views.py:280
msgid "Approve"
msgstr "موافق"

#: apps/expenses/views.py:280
msgid "Reject"
msgstr "غير موافق"

#: apps/expenses/views.py:292
msgid "New vote"
msgstr "تصويت جديد"

#: apps/expenses/views.py:327
msgid ""
"This expense has payments and cannot be deleted. Reverse the payments or add "
"a credit note instead."
msgstr ""
"عليه مدفوعات ولا يمكن حذفه. قم بإلغاء المدفوعات أو أضف إشعار دائن بدلاً من "
"ذلك."

#: apps/expenses/views.py:407
msgid "No file provided. Use multipart/form-data with key 'file'."
msgstr "لم يتم تقديم ملف. استخدم multipart/form-data بمفتاح 'file'."

#: apps/expenses/views.py:422
#, python-format
msgid "Unsupported file type '%(mime_type)s'. Allowed types: %(allowed_types)s"
msgstr ""
"نوع الملف '%(mime_type)s' غير مدعوم. الأنواع المسموحة: %(allowed_types)s"

#: apps/expenses/views.py:434
#, python-format
msgid "File size %(size)s bytes exceeds the %(limit)s MB limit."
msgstr "حجم الملف %(size)s بايت يتجاوز الحد المسموح %(limit)s ميغابايت."

#: apps/governance/serializers.py:30
msgid "The closing time must be in the future."
msgstr "يجب أن يكون وقت الإغلاق في المستقبل."

#: apps/governance/views.py:69
msgid "This vote is closed."
msgstr "هذا التصويت مغلق."

#: apps/governance/views.py:74
msgid "Choose one of this vote's options for your unit."
