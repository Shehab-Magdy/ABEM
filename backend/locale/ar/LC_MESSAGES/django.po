# Messages added with the payments, invites, reminders and account features

msgid "Allocated amount cannot be negative."
msgstr "لا يمكن أن يكون المبلغ المخصّص سالباً."

msgid "Allocation for '%(title)s' (%(value)s) is more than this apartment still owes (%(remaining)s)."
msgstr "المبلغ المخصّص للمصروف «%(title)s» (%(value)s) أكبر مما لا يزال مستحقاً على هذه الوحدة (%(remaining)s)."

msgid "An allocated expense is not owed by this apartment (or is already paid)."
msgstr "أحد المصروفات المخصّص لها مبلغ غير مستحق على هذه الوحدة (أو مدفوع بالفعل)."

msgid "Cleaning"
msgstr "النظافة"

msgid "Confirmed"
msgstr "مؤكَّد"

msgid "Done"
msgstr "تم"

msgid "Due soon"
msgstr "يستحق قريباً"

msgid "Each allocation needs a valid amount."
msgstr "يلزم لكل تخصيص مبلغ صحيح."

msgid "Each expense can appear only once."
msgstr "يمكن ذكر كل مصروف مرة واحدة فقط."

msgid "Electricity"
msgstr "الكهرباء"

msgid "Elevator"
msgstr "المصعد"

msgid "If that email is registered, a reset link has been sent."
